# Copie para .env e preencha. O .env não é versionado.
# Nos builds EAS, cadastre as mesmas variáveis com `eas env:create`.

# Obrigatório para o login com Google (OAuth client do tipo "Web" no
# Google Cloud / Firebase console).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional Google Sign-In override for iOS. When it is not set, the
# GoogleService-Info.plist file is used.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
